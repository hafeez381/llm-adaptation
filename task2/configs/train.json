{
  "seed": 6304,
  "microbatch": 8,
  "grad_accum": 2,
  "weight_decay": 0.01,
  "clip_grad_norm": 1.0,
  "warmup_frac": 0.05,
  "lr_floor_frac": 0.1,
  "stages": [
    {"name": "caption", "updates": 2250, "conn_lr": 1e-3, "lora_lr": null, "mix": {"caption": 1.0}},
    {"name": "instruct", "updates": 1500, "conn_lr": 1e-4, "lora_lr": 2e-5,
     "mix": {"presence": 0.5, "counting": 0.25, "caption": 0.25}},
    {"name": "vqa", "updates": 750, "conn_lr": 5e-5, "lora_lr": 1e-5,
     "mix": {"vqa": 0.7, "presence": 0.1, "counting": 0.1, "caption": 0.1}}
  ],
  "lora": {"r": 16, "alpha": 32, "dropout": 0.05, "lora_targets": ["q_proj", "k_proj", "v_proj", "o_proj"]},
  "ckpt_every": 250,
  "dev_eval_at": [0, 500, 1000, 1500, 2000, 2250, 2500, 3000, 3500, 3750, 4000, 4500],
  "gen_check_at": [3750, 4500],
  "calibration_images": 512,
  "smoke": {
    "stage_updates": [4, 3, 3], "ckpt_every": 4, "dev_eval_at": [0, 4, 10], "gen_check_at": [10],
    "calibration_images": 8,
    "tiny_lm": {"hidden_size": 64, "intermediate_size": 128, "num_hidden_layers": 2, "num_attention_heads": 4,
                "num_key_value_heads": 2, "head_dim": 16}
  }
}
